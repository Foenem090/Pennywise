# Penny Wise Backend — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Application ──────────────────────────────────────────────────────────────
PROJECT_NAME="Penny Wise API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for offline local testing):
DATABASE_URL=sqlite:///./pennywise.db
# Neon PostgreSQL (Psycopg 3 driver):
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<neon_hostname>/<dbname>?sslmode=require
# Local PostgreSQL development (Psycopg 3 driver):
# DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/pennywise_db


# ─── Frontend Application URL ─────────────────────────────────────────────────
# Used for client-facing links in transactional emails and redirects.
# Local development default: http://localhost:5173
# In production, set to your deployed frontend domain.
FRONTEND_URL=http://localhost:5173

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# ─── CoinGecko Market Data ────────────────────────────────────────────────────
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
CACHE_TTL_SECONDS=60

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── Resend Transactional Email ───────────────────────────────────────────────
# Sign up at https://resend.com and create an API key under API Keys → Create API Key.
# Requires a verified sending domain (see README § Email Setup).
#
# Your Resend API key (starts with "re_"):
RESEND_API_KEY=re_your_api_key_here

# The verified sender email address (must match your verified domain in Resend):
MAIL_FROM=hello@yourdomain.com

# The administrator email address that receives contact form notifications:
ADMIN_EMAIL=admin@yourdomain.com
