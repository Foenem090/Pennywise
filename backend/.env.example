# Penny Wise Backend Configuration

PROJECT_NAME="Penny Wise API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database: SQLite for local dev, or PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/pennywise
DATABASE_URL=sqlite:///./pennywise.db

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# External API settings
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
CACHE_TTL_SECONDS=60

# Rate Limiting & Abuse Prevention
RATE_LIMIT_PER_MINUTE=60

